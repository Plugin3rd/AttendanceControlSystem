@{
    var page = Convert.ToString(ViewData["Page"]) ?? "";
    var title = Convert.To title = Convert.ToString(ViewData["Title"]) ?? "ردد";
    var isLoginPage = page.Equals("login", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@title - سامانه کنترل تردد</title>

    <meta name="theme-color" content="#17324d" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body data-page="@page">

@if (!isLoginPage)
{
    <header class="app-header">
        <div class="header-inner">
            <a class="brand" href="@Url.Action("Dashboard", "Web")">
                <span class="brand-symbol">ت</span>
                <span>
                    <strong>سامانه کنترل تردد</strong>
                    <small>مدیریت ورود و خروج</small>
                </span>
            </a>

            <button classsmall>
                </span>
            </a>

            <button class="mobile-menu-button"
-label="نمایش منو">
                ☰
            </button>

            <nav class="main-nav" id="mainNav">
                <a href="@Url.Action("Dashboard", "Web")"
                   data-nav="dashboard">
                    داشبورد
                </a>

                <a href="@Url.Action("People", "Web")"
                   data-nav="people">
                    افراد
                </a>

                <a href="@Url.Action("Units", "Web")"
                   data-nav="units">
                    واحدها
                </a>

                <a href="@Url.Action("Attendance", "Web")"
                   data-nav="attendance">
                    تردد
                </a>

                <a href="@Url.Action("Reports", "Web")"
                   data-nav="reports">
                    گزارش‌ها
                </a>

                <a href="@Url.Action("Users", "Web")"
                   data-nav="users"
                   data-admin-only>
                    کاربران
                </a>

                <a href="@Url.Action("Backup", "Web")"
                   data-nav="backup"
                   data-admin-only>
                    پشتیبان‌گیری
                </a>
            </nav>

            <div class="user-menu">
                <span id="currentUser" class="current-user">کاربر</span>
                <button id="logoutButton" class="button button-light button-small" type="button">
                    خروج
                </button>
            </div>
        </div>
    </header>
}

<main class="page-container">
    @if (!isLoginPage)
    {
        <div id="globalStatus" class="status" role="alert" hidden></div>
    }

    @RenderBody()
</main>

@if (!isLoginPage)
{
    <footer class="app-footer">
        سامانه کنترل تردد
    </footer>
}

<script src="~/js/app.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
