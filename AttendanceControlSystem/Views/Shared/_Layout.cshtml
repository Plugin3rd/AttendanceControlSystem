@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123047" />
    <title>@ViewData["Title"] - سامانه کنترل تردد</title>
    <link rel="stylesheet" href="~/css/site.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" asp-controller="Dashboard" asp-action="Index" aria-label="سامانه کنترل تردد">
                <span class="brand-mark" aria-hidden="true">ت</span>
                <span>سامانه کنترل تردد</span>
            </a>
            <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">
                <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                <span>منو</span>
            </button>
            <nav class="primary-nav" id="primary-navigation" aria-label="منوی اصلی">
                <ul class="nav-list">
                    <li><a class="nav-link" asp-controller="Dashboard" asp-action="Index">داشبورد</a></li>
                    <li><a class="nav-link" asp-controller="People" asp-action="Index">افراد</a></li>
                    <li><a class="nav-link" asp-controller="Units" asp-action="Index">واحدها</a></li>
                    <li><a class="nav-link" asp-controller="Attendance" asp-action="Index">ورود و خروج</a></li>
                    <li><a class="nav-link" asp-controller="Reports" asp-action="Index">گزارشات</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a class="nav-link" asp-controller="Users" asp-action="Index">کاربران</a></li>
                        <li><a class="nav-link" asp-controller="Backup" asp-action="Index">پشتیبان‌گیری</a></li>
                    }
                </ul>
            </nav>
            <div class="user-area">
                <span class="user-name">
                    @if (isAuthenticated)
                    {
                        <text>سلام، @(User.Identity?.Name ?? "کاربر")</text>
                    }
                    else
                    {
                        <text>کاربر</text>
                    }
                </span>
                @if (!string.IsNullOrWhiteSpace(role))
                {
                    <span class="role-badge @(role == "Admin" ? "role-admin" : "")">@role</span>
                }
                @if (isAuthenticated)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button class="logout-button" type="submit">خروج</button>
                    </form>
                }
                else
                {
                    <a class="login-link" asp-controller="Account" asp-action="Login">ورود</a>
                }
            </div>
        </div>
    </header>
    <main id="main-content" class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year سامانه کنترل تردد</p>
    </footer>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
