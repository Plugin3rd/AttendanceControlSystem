# ۶. `Views/Web/People.cshtml`

cshtml
@{
ViewData["Title"] = "اشخاص";
}

<div class="page-header">
<div>
<h1>اشخاص</h1>
<p class="text-muted">مدیریت اطلاعات افراد سامانه</p>
</div>

<button class="btn btn-primary" id="newPersonButton">
<i class="bi bi-plus-lg"></i>
شخص جدید
</button>
</div>

<div class="card mb-4">
<div class="card-body">
<form id="peopleSearchForm" class="row g-2">
<div class="col-md-10">
<input id="peopleSearch"
class="form-control"
placeholder="جست‌وجو بر اساس نام، کد ملی یا شماره پرسنلی..." />
</div>

<div class="col-md-2">
<button class="btn btn-outline-primary w-100" type="submit">
<i class="bi bi-search"></i>
جست‌وجو
</button>
</div>
</form>
</div>
</div>

<div class="card">
<div class="card-header d-flex justify-content-between align-items-center">
<h5 class="mb-0">فهرست اشخاص</h5>
<span class="badge text-bg-secondary" id="peopleCount">۰</span>
</div>

<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
<thead>
<tr>
<th>نام و نام خانوادگی</th>
<th>کد ملی</th>
<th>شماره پرسنلی</th>
<th>واحد</th>
<th>وضعیت</th>
<th>عملیات</th>
</tr>
</thead>

<tbody id="peopleTableBody">
<tr>
<td colspan="6" class="text-center text-muted py-4">
در حال بارگذاری...
</td>
</tr>
</tbody>
</table>
</div>
</div>

<div class="modal fade" id="personModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-lg">
<div class="modal-content">

<div class="modal-header">
<h5 class="modal-title" id="personModalTitle">شخص جدید</h5>
<button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
</div>

<form id="personForm">
<div class="modal-body">
<input type="hidden" id="personId" />

<div id="personFormAlert" class="alert d-none"></div>

<div class="row g-3">

<div class="col-md-6">
<label class="form-label" for="firstName">نام</label>
<input id="firstName" class="form-control" required />
</div>

<div class="col-md-6">
<label class="form-label" for="lastName">نام خانوادگی</label>
<input id="lastName" class="form-control" required />
</div>

<div class="col-md-6">
<label class="form-label" for="nationalId">کد ملی</label>
<input id="nationalId"
class="form-control"
maxlength="10"
required />
</div>

<div class="col-md-6">
<label class="form-label" for="personnelCode">شماره پرسنلی</label>
<input id="personnelCode" class="form-control" />
</div>

<div class="col-md-6">
<label class="form-label" for="phone">شماره تماس</label>
<input id="phone" class="form-control" />
</div>

<div class="col-md-6">
<label class="form-label" for="unitId">واحد</label>
<select id="unitId" class="form-select">
<option value="">انتخاب واحد</option>
</select>
</div>

<div class="col-12">
<div class="form-check">
<input id="isActive"
class="form-check-input"
type="checkbox"
checked />
<label class="form-check-label" for="isActive">
فعال
</label>
</div>
</div>

</div>
</div>

<div class="modal-footer">
<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
انصراف
</button>

<button type="submit" class="btn btn-primary">
ذخیره
</button>
</div>
</form>
</div>
</div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
App.requireAuth();
PeoplePage.init();
});
</script>
}

