# ۱. `Views/Shared/_ViewImports.cshtml`
```cshtml
@using AttendanceControlSystem
@using AttendanceControlSystem.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

---

# ۲. `Views/Shared/_ViewStart.cshtml`

cshtml
@{
Layout = "_Layout";
}

---

# ۳. `Views/Shared/_Layout.cshtml`

cshtml
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>@ViewData["Title"] - سامانه کنترل تردد</title>

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

<div id="appShell" class="app-shell d-none">

<aside class="sidebar" id="sidebar">
<div class="sidebar-brand">
<i class="bi bi-shield-check"></i>
<span>کنترل تردد</span>
</div>

<nav class="sidebar-nav">
<a class="nav-link" href="/Web/Dashboard">
<i class="bi bi-speedometer2"></i>
<span>داشبورد</span>
</a>

<a class="nav-link" href="/Web/People">
<i class="bi bi-people"></i>
<span>اشخاص</span>
</a>

<a class="nav-link" href="/Web/Units">
<i class="bi bi-diagram-3"></i>
<span>واحدها</span>
</a>

<a class="nav-link" href="/Web/Attendance">
<i class="bi bi-clock-history"></i>
<span>تردد</span>
</a>

<a class="nav-link" href="/Web/Reports">
<i class="bi bi-bar-chart"></i>
<span>گزارش‌ها</span>
</a>

<a class="nav-link admin-only" href="/Web/Users">
<i class="bi bi-person-gear"></i>
<span>کاربران</span>
</a>

<a class="nav-link admin-only" href="/Web/Backup">
<i class="bi bi-database"></i>
<span>پشتیبان‌گیری</span>
</a>
</nav>

<div class="sidebar-footer">
<button type="button" class="btn btn-outline-light btn-sm w-100" id="logoutButton">
<i class="bi bi-box-arrow-right"></i>
خروج
</button>
</div>
</aside>

<main class="main-content">

<header class="topbar">
<button type="button" class="btn btn-light d-lg-none" id="sidebarToggle">
<i class="bi bi-list"></i>
</button>

<div class="topbar-title">
<span id="pageTitle">@ViewData["Title"]</span>
</div>

<div class="user-info">
<i class="bi bi-person-circle"></i>
<span id="currentUsername">کاربر</span>
<span class="badge text-bg-primary" id="currentRole"></span>
</div>
</header>

<div class="content-wrapper">
<div id="globalAlert" class="alert d-none" role="alert"></div>

@RenderBody()
</div>

</main>
</div>

<div id="loginShell">
@if (ViewContext.RouteData.Values["action"]?.ToString() == "Login")
{
@RenderBody()
}
</div>

<div id="loadingOverlay" class="loading-overlay d-none">
<div class="spinner-border text-primary" role="status">
<span class="visually-hidden">در حال بارگذاری...</span>
</div>
<div class="mt-2">در حال پردازش...</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/app.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

---

# ۴. `Views/Web/Login.cshtml`

cshtml
@{
ViewData["Title"] = "ورود به سامانه";
Layout = "_Layout";
}

<div class="login-page">
<div class="login-card">

<div class="login-logo">
<i class="bi bi-shield-check"></i>
</div>

<h1 class="login-title">سامانه کنترل تردد</h1>
<p class="login-subtitle">ورود به پنل مدیریت</p>

<div id="loginAlert" class="alert d-none" role="alert"></div>

<form id="loginForm" novalidate>

<div class="mb-3">
<label for="username" class="form-label">نام کاربری</label>

<div class="input-group">
<span class="input-group-text">
<i class="bi bi-person"></i>
</span>

<input id="username"
name="username"
class="form-control"
autocomplete="username"
required />
</div>

<div class="invalid-feedback">
نام کاربری را وارد کنید.
</div>
</div>

<div class="mb-3">
<label for="password" class="form-label">رمز عبور</label>

<div class="input-group">
<span class="input-group-text">
<i class="bi bi-lock"></i>
</span>

<input id="password"
name="password"
type="password"
class="form-control"
autocomplete="current-password"
required />

<button type="button"
class="btn btn-outline-secondary"
id="togglePassword">
<i class="bi bi-eye"></i>
</button>
</div>

<div class="invalid-feedback">
رمز عبور را وارد کنید.
</div>
</div>

<button type="submit" class="btn btn-primary w-100" id="loginButton">
<i class="bi bi-box-arrow-in-right"></i>
ورود
</button>
</form>

<div class="text-center mt-4 text-muted small">
سامانه کنترل تردد
</div>
</div>
</div>

---

