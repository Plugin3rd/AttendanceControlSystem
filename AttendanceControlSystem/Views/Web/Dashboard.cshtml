@{
    ViewData["Title"] = "داشبورد";
    ViewData["Page"] = "dashboard";
}

<div class="page-heading">
    <div>
        <h1>داشبورد</h1>
        <p class="muted-text">نمای کلی وضعیت سامانه</p>
    </div</p>
    </div>

    <button id="button button-secondary"
            type="button">
        به‌روزرسانی
    </button>
</div>

<section class="stats-grid">
    <article class="stat-card">
        <div class="stat-icon blue">افراد</div>
        <div>
            <span class="stat-label">تعداد افراد</span>
            <strong id="statPeople" class="stat-value">—</strong>
        </div>
    </article>

    <article class="stat-card">
        <div class="stat-icon green">واحد</div>
        <div>
            <span class="stat-label">تعداد واحددر ادامه کد کامل فایل‌های Views ارائه شده است. این نسخه فرض می‌کند رابط کاربری از طریق JavaScript به APIهای موجود متصل می‌شود و JWT در `localStorage` ذخیره می‌گردد.

