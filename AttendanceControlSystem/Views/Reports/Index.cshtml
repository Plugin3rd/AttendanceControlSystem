@model AttendanceControlSystem_vm.ReportIndexViewModel
@{
    ViewData["Title"] = "گزارشات";
    var totalPages = Math.Max(1, (int?)(ViewBag.TotalPages) ?? 1);
    var startRoute = Model.Start?.ToString("yyyy-MM-dd");
    var endRoute = Model.End?.ToString("yyyy-MM-dd");
}
<h2>گزارشات</h2>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-controller="Reports" asp-action="Index" method="get" class="search-form">
    <label>از تاریخ:</label>
    <input type="date" name="start" value="@(Model.Start?.ToString("yyyy-MM-dd"))" />
    <label>تا تاریخ:</label>
    <input type="date" name="end" value="@(Model.End?.ToString("yyyy-MM-dd"))" />
    <label>واحد:</label>
    <select name="unitId">
        <option value="">همه</option>
        @foreach (var unit in Model.Units)
        {
            <option value="@unit.Id" selected="@(Model.UnitId == unit.Id ? "selected" : null)">@unit.Name</option>
        }
    </select>
    <label>وضعیت:</label>
    <select name="status">
        <option value="">همه</option>
        <option value="0" selected="@(Model.Status == 0 ? "selected" : null)">حاضر</option>
        <option value="1" selected="@(Model.Status == 1 ? "selected" : null)">خروج داده</option>
    </select>
    <label>اندازه صفحه:</label>
    <select name="pageSize">
        @foreach (var size in new[] { 10, 20, 50, 100 })
        {
            <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">فیلتر</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>نام</th>
            <th>کد ملی</th>
            <th>زمان ورود</th>
            <th>زمان خروج</th>
            <th>واحد</th>
            <th>ثبت‌کننده</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@(item.Person?.FirstName ?? "") @(item.Person?.LastName ?? "")</td>
                <td>@(item.Person?.NationalId ?? "")</td>
                <td>@item.EntryAtUtc.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@(item.ExitAtUtc?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                <td>@(item.Unit?.Name ?? "-")</td>
                <td>@(item.RegisteredByUser?.Username ?? (item.RegisteredByUserId?.ToString() ?? "-"))</td>
                <td>@(item.ExitAtUtc is null ? "حاضر" : "خروج داده")</td>
                <td><a asp-controller="Attendance" asp-action="Details" asp-route-id="@item.Id">جزئیات</a></td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="8">رکوردی با این فیلترها یافت نشد.</td>
            </tr>
        }
    </tbody>
</table>
<div class="pagination">
    <span>صفحه @Model.Page از @totalPages (@Model.Total رکورد)</span>
    @if (totalPages > 1)
    {
        <a asp-controller="Reports" asp-action="Index" asp-route-page="1" asp-route-start="@startRoute" asp-route-end="@endRoute" asp-route-unitId="@Model.UnitId" asp-route-status="@Model.Status" asp-route-pageSize="@Model.PageSize">اول</a>
    }
    @if (Model.Page > 1)
    {
        <a asp-controller="Reports" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-start="@startRoute" asp-route-end="@endRoute" asp-route-unitId="@Model.UnitId" asp-route-status="@Model.Status" asp-route-pageSize="@Model.PageSize">قبلی</a>
    }
    @if (Model.Page < totalPages)
    {
        <a asp-controller="Reports" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-start="@startRoute" asp-route-end="@endRoute" asp-route-unitId="@Model.UnitId" asp-route-status="@Model.Status" asp-route-pageSize="@Model.PageSize">بعدی</a>
    }
    @if (totalPages > 1)
    {
        <a asp-controller="Reports" asp-action="Index" asp-route-page="@totalPages" asp-route-start="@startRoute" asp-route-end="@endRoute" asp-route-unitId="@Model.UnitId" asp-route-status="@Model.Status" asp-route-pageSize="@Model.PageSize">آخر</a>
    }
</div>
