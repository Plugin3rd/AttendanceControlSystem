@model AttendanceControlSystem_vm.AttendanceIndexViewModel
@{
    ViewData["Title"] = "ورود و خروج";
    var totalPages = Math.Max(1, (int?)(ViewBag.TotalPages) ?? 1);
}
<h2>ورود و خروج</h2>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-controller="Attendance" asp-action="Index" method="get" class="search-form">
    <input type="number" name="personId" value="@Model.PersonId" placeholder="شناسه فرد" min="1" />
    <input type="text" name="nationalId" value="@Model.NationalId" placeholder="کد ملی" inputmode="numeric" maxlength="10" />
    <input type="number" name="pageSize" value="@Model.PageSize" placeholder="اندازه صفحه" min="1" max="100" />
    <button type="submit">جستجو</button>
</form>
<a asp-controller="Attendance" asp-action="Create" class="btn btn-primary">ثبت ورود</a>
<table class="table">
    <thead>
        <tr>
            <th>نام</th>
            <th>کد ملی</th>
            <th>واحد</th>
            <th>زمان ورود</th>
            <th>زمان خروج</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@(item.Person?.FirstName ?? "") @(item.Person?.LastName ?? "")</td>
                <td>@(item.Person?.NationalId ?? "")</td>
                <td>@(item.Unit?.Name ?? "")</td>
                <td>@item.EntryAtUtc.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@(item.ExitAtUtc?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                <td>@(item.ExitAtUtc is null ? "حاضر" : "خروج داده")</td>
                <td>
                    <a asp-controller="Attendance" asp-action="Details" asp-route-id="@item.Id">جزئیات</a>
                    @if (item.ExitAtUtc is null)
                    {
                        <text> | </text>
                        <a asp-controller="Attendance" asp-action="Edit" asp-route-id="@item.Id">ثبت خروج</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="7">رکوردی یافت نشد.</td>
            </tr>
        }
    </tbody>
</table>
<div class="pagination">
    <span>صفحه @Model.Page از @totalPages (@Model.Total رکورد)</span>
    @if (totalPages > 1)
    {
        <a asp-controller="Attendance" asp-action="Index" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-personId="@Model.PersonId" asp-route-nationalId="@Model.NationalId">اول</a>
    }
    @if (Model.Page > 1)
    {
        <a asp-controller="Attendance" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-personId="@Model.PersonId" asp-route-nationalId="@Model.NationalId">قبلی</a>
    }
    @if (Model.Page < totalPages)
    {
        <a asp-controller="Attendance" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-personId="@Model.PersonId" asp-route-nationalId="@Model.NationalId">بعدی</a>
    }
    @if (totalPages > 1)
    {
        <a asp-controller="Attendance" asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="@Model.PageSize" asp-route-personId="@Model.PersonId" asp-route-nationalId="@Model.NationalId">آخر</a>
    }
</div>
